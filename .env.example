# Copy this file to .env.local and fill in values.

# Unique identifier Plex uses to recognize this app instance.
# Optional: if left blank, one is auto-generated on first run and saved
# to data/client_id. Leave it blank when running several copies (server +
# dev machines) against the same Plex server: each copy's id is how the
# others tell it apart in the "already being auto-updated elsewhere" check.
# Copies sharing an id look like one instance and never see a conflict.
# Generate one with: node -e "console.log(crypto.randomUUID())"
PLEX_CLIENT_ID=

# Friendly name for this copy, shown in the playlist description marker and
# the "auto-updated elsewhere" message, e.g. "server", "desktop", "macbook".
# Optional: defaults to the hostname (a container id inside Docker).
INSTANCE_NAME=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Key (32 bytes, base64) used to encrypt Plex tokens stored on disk.
# Optional: if left blank, one is generated on first run and saved to
# data/.encryption_key. Back that file up: losing it means users must re-link.
# For better security keep the key OUT of the data volume by setting it here,
# or point TOKEN_ENCRYPTION_KEY_FILE at a file/Docker secret that contains it.
# Generate one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_FILE=
