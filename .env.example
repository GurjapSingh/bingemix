# Copy this file to .env.local and fill in values.

# Unique identifier Plex uses to recognize this app instance.
# Optional: if left blank, one is auto-generated on first run and saved
# to data/client_id. Set this if you want multiple dev machines (or a
# dev machine and a deployment) to be recognized by Plex as the same app.
# Generate one with: node -e "console.log(crypto.randomUUID())"
PLEX_CLIENT_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000
